<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationValue" table="sylius_classification_value">
        <unique-constraints>
            <unique-constraint columns="code" name="uniq_sylius_classification_value_code"/>
        </unique-constraints>

        <indexes>
            <index columns="classification_id" name="idx_sylius_classification_value_axis"/>
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" column="code" type="string" length="96"/>
        <field name="position" column="position" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="config" column="config" type="json" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>

        <many-to-one field="classification" target-entity="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationInterface" inversed-by="values">
            <join-column name="classification_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <one-to-many field="translations" target-entity="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationValueTranslationInterface" mapped-by="translatable" index-by="locale" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
