<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="FluffyDiscord\SyliusClassificationBundle\Entity\Classification" table="sylius_classification">
        <unique-constraints>
            <unique-constraint columns="code" name="uniq_sylius_classification_code"/>
        </unique-constraints>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" column="code" type="string" length="64"/>
        <field name="multiple" column="multiple" type="boolean"/>
        <field name="position" column="position" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="config" column="config" type="json" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>

        <one-to-many field="values" target-entity="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationValueInterface" mapped-by="classification">
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>

        <one-to-many field="translations" target-entity="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationTranslationInterface" mapped-by="translatable" index-by="locale" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
