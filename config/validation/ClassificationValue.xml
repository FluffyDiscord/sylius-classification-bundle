<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping
                    https://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">

    <class name="FluffyDiscord\SyliusClassificationBundle\Entity\ClassificationValue">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">code</option>
            <option name="message">sylius_classification.classification_value.code.unique</option>
            <option name="groups">
                <value>sylius</value>
            </option>
        </constraint>

        <property name="code">
            <constraint name="NotBlank">
                <option name="message">sylius_classification.classification_value.code.not_blank</option>
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
            <constraint name="Length">
                <option name="max">96</option>
                <option name="maxMessage">sylius_classification.classification_value.code.max_length</option>
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
            <constraint name="Regex">
                <option name="pattern">/^[a-zA-Z0-9_\-]+$/</option>
                <option name="message">sylius_classification.classification_value.code.regex</option>
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>

        <property name="classification">
            <constraint name="NotNull">
                <option name="message">sylius_classification.classification_value.classification.not_null</option>
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>

        <property name="translations">
            <constraint name="Valid"/>
        </property>
    </class>

</constraint-mapping>
