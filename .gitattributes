# Keep the distributed package (composer require / Packagist dist) lean:
# everything below stays in the git repo but is excluded from the release archive.
/.github            export-ignore
/.ddev              export-ignore
/tests              export-ignore
/e2e                export-ignore
/assets             export-ignore
/docs               export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon       export-ignore
/ecs.php            export-ignore

*.md text eol=lf
*.php text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.twig text eol=lf
